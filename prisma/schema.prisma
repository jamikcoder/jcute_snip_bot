generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  telegramId   BigInt      @unique
  firstName    String
  lastName     String
  phone        String
  birthDate    DateTime
  loyaltyCount Int         @default(0)
  lang         String      @default("uz")
  notifSeenAt  DateTime?
  createdAt    DateTime    @default(now())
  bookings     Booking[]
  review       Review?
  aiMessages   AiMessage[]
}

model Booking {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime
  startTime          String
  endTime            String
  services           String
  totalPrice         Int
  totalMinutes       Int
  paymentMethod      PaymentMethod
  contactPhone       String
  status             BookingStatus @default(BOOKED)
  cancellationReason String?
  countedInStats     Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([date, startTime])
  @@index([userId, status])
}

enum PaymentMethod {
  CASH
  CARD
}

enum BookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model DayOff {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String
  titleRu   String?
  bodyRu    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}